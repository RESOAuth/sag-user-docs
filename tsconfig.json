// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
//
// Not extending "@docusaurus/tsconfig" directly: that package still sets
// "baseUrl", which TypeScript 7 has removed outright (TS5102). The options
// below are copied from it with "baseUrl" dropped and "paths" left to
// resolve relative to this file instead, per TypeScript's own migration
// note.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
